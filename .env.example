# ── WHAT CHANGED? — Environment Configuration ──

# Optional: Vision AI provider for semantic analysis.
# If not configured, the app will still detect visual changes
# but will label them as "Visual Change" instead of specific object names.

# Example for OpenAI Vision:
# VITE_VISION_API_URL=https://api.openai.com/v1/chat/completions
# VITE_VISION_API_KEY=sk-...

# Example for Google Gemini Vision:
# VITE_VISION_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-pro-vision:generateContent
# VITE_VISION_API_KEY=...

# Note: API keys should NEVER be committed. This file is an example only.
